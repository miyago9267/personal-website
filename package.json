    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
